# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=careflow
MONGODB_CONNECT_TIMEOUT_MS=5000

# Gemma via Ollama (local, no API key needed)
# Setup: brew install ollama && ollama pull gemma2:2b && ollama serve
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma2:2b

# Fetch.ai Agentverse — two agents
AGENT_MONITOR_SEED=careflow-monitor-agent-seed-phrase-001
AGENT_COORDINATOR_SEED=careflow-coordinator-agent-seed-phrase-002
# Fill these in after first run (address is printed to console on startup)
AGENT_MONITOR_ADDRESS=agent1q_FILL_AFTER_FIRST_RUN
AGENT_COORDINATOR_ADDRESS=agent1q_FILL_AFTER_FIRST_RUN

DEVICE_ID=careflow_watch_001

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ElevenLabs — voice alerts for HIGH/CRITICAL events
# API key: console.elevenlabs.io → Profile → API Keys
# Premade voice from ElevenLabs API docs; works with free-tier API TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Twilio WhatsApp (Sandbox)
# Each recipient must join the sandbox once by sending the join keyword to +14155238886 on WhatsApp.
# Find the keyword at: console.twilio.com → Messaging → Try it out → Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Comma-separated list of recipient numbers (include country code, e.g. +19253999636,+14081234567)
TWILIO_TO_NUMBERS=+1XXXXXXXXXX

# Demo
DEFAULT_PATIENT_ID=patient-001
DEMO_PATIENT_ID=patient-001
ANOMALY_THRESHOLD=0.65
VITALS_SOURCE=synthetic
VITALS_REPLAY_PATH=vitals/replays/bidmc_25_careflow.csv
VITALS_REPLAY_LOOP=true
